{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wulin-platform",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/uploads/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PLATFORM",
        "class_name": "WulinPlatform"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "exports": {
    "WulinPlatform": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
